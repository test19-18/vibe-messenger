# Only the public project URL and anon/publishable key belong in a client app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Mobile Auth callback. Add this exact URI to Supabase Auth → Additional Redirect URLs.
SUPABASE_AUTH_CALLBACK=ru.vibe.messenger://auth/callback

# Never put a service-role key in this repository or a Flutter build.
